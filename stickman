#include <windows.h>
#include <vector>
#include <cstring>
#include <commdlg.h>


#define ID_ADD_CIRCLE 1001
#define ID_REMOVE_CIRCLE 1002



// ===== CIRCLE OBJECT =====

struct Circle
{
    int x;
    int y;
    double scale;
    COLORREF color;
};


// Store circles
std::vector<Circle> circles;



bool placingCircle = false;

bool growing = false;
bool shrinking = false;




LRESULT CALLBACK WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
{
    switch(uMsg)
    {


        // ===== DRAW =====

        case WM_PAINT:
        {
            PAINTSTRUCT ps;
            HDC hdc = BeginPaint(hwnd, &ps);



            for(auto& circle : circles)
            {

                HPEN pen = CreatePen(
                    PS_SOLID,
                    3,
                    circle.color
                );


                HPEN oldPen =
                    (HPEN)SelectObject(hdc, pen);



                Ellipse(
                    hdc,
                    circle.x,
                    circle.y,
                    (int)(circle.x + 100 * circle.scale),
                    (int)(circle.y + 100 * circle.scale)
                );



                SelectObject(
                    hdc,
                    oldPen
                );


                DeleteObject(pen);
            }




            if(placingCircle)
            {
                const char message[] =
                    "Click where you want the circle";


                TextOut(
                    hdc,
                    10,
                    10,
                    message,
                    strlen(message)
                );
            }



            EndPaint(hwnd,&ps);

            return 0;
        }





        // ===== MENU =====

        case WM_COMMAND:
        {
            switch(LOWORD(wParam))
            {

                case ID_ADD_CIRCLE:
                {
                    placingCircle = true;

                    InvalidateRect(
                        hwnd,
                        NULL,
                        FALSE
                    );

                    return 0;
                }




                case ID_REMOVE_CIRCLE:
                {
                    circles.clear();

                    placingCircle = false;


                    InvalidateRect(
                        hwnd,
                        NULL,
                        TRUE
                    );

                    return 0;
                }

            }

            break;
        }





        // ===== LEFT CLICK =====

        case WM_LBUTTONDOWN:
        {

            if(placingCircle)
            {

                Circle newCircle;


                newCircle.x = LOWORD(lParam);
                newCircle.y = HIWORD(lParam);

                newCircle.scale = 0.5;


                // Default color: blue
                newCircle.color =
                    RGB(0,0,255);



                circles.push_back(newCircle);



                placingCircle = false;



                InvalidateRect(
                    hwnd,
                    NULL,
                    FALSE
                );
            }


            return 0;
        }





        // ===== RIGHT CLICK COLOR CHANGE =====

        case WM_RBUTTONDOWN:
        {

            int mouseX = LOWORD(lParam);
            int mouseY = HIWORD(lParam);



            for(auto& circle : circles)
            {

                if(
                    mouseX >= circle.x &&
                    mouseX <= circle.x + 100 * circle.scale &&
                    mouseY >= circle.y &&
                    mouseY <= circle.y + 100 * circle.scale
                )
                {

                    CHOOSECOLOR cc = {};

                    COLORREF customColors[16] = {};



                    cc.lStructSize =
                        sizeof(CHOOSECOLOR);

                    cc.hwndOwner =
                        hwnd;

                    cc.lpCustColors =
                        customColors;

                    cc.rgbResult =
                        circle.color;

                    cc.Flags =
                        CC_FULLOPEN |
                        CC_RGBINIT;



                    if(ChooseColor(&cc))
                    {
                        circle.color =
                            cc.rgbResult;
                    }



                    InvalidateRect(
                        hwnd,
                        NULL,
                        FALSE
                    );


                    break;
                }
            }


            return 0;
        }

        // ===== KEY DOWN =====

        case WM_KEYDOWN:
        {

            if(circles.empty())
                break;



            Circle& circle =
                circles.back();



            switch(wParam)
            {

                case VK_LEFT:
                    circle.x -= 10;
                    break;


                case VK_RIGHT:
                    circle.x += 10;
                    break;


                case VK_UP:
                    circle.y -= 10;
                    break;


                case VK_DOWN:
                    circle.y += 10;
                    break;
                
                case VK_ADD:
                case VK_OEM_PLUS:
                    growing = true;
                    break;

                case VK_SUBTRACT:
                case VK_OEM_MINUS:
                    shrinking = true;
                    break;

            }

            InvalidateRect(
                hwnd,
                NULL,
                FALSE
            );


            return 0;
        }

        // ===== KEY UP =====

        case WM_KEYUP:
        {

            switch(wParam)
            {

                case VK_ADD:
                case VK_OEM_PLUS:

                    growing = false;
                    break;



                case VK_SUBTRACT:
                case VK_OEM_MINUS:

                    shrinking = false;
                    break;

            }


            return 0;
        }

        // ===== TIMER =====

        case WM_TIMER:
        {

            if(!circles.empty())
            {

                Circle& circle =
                    circles.back();

                if(growing)
                    circle.scale += 0.02;

                if(shrinking)
                    circle.scale -= 0.02;

                if(circle.scale > 3.0)
                    circle.scale = 3.0;

                if(circle.scale < 0.1)
                    circle.scale = 0.1;

                InvalidateRect(
                    hwnd,
                    NULL,
                    FALSE
                );
            }


            return 0;
        }

        case WM_DESTROY:
        {
            KillTimer(hwnd,1);

            PostQuitMessage(0);

            return 0;
        }

    }

    return DefWindowProc(
        hwnd,
        uMsg,
        wParam,
        lParam
    );
}

int WINAPI WinMain(
    HINSTANCE hInstance,
    HINSTANCE,
    LPSTR,
    int nCmdShow)
{

    const char CLASS_NAME[] =
        "CircleEditor";

    WNDCLASS wc = {};

    wc.lpfnWndProc =
        WindowProc;

    wc.hInstance =
        hInstance;

    wc.lpszClassName =
        CLASS_NAME;

    wc.hbrBackground =
        (HBRUSH)(COLOR_WINDOW + 1);

    RegisterClass(&wc);

    HWND hwnd = CreateWindowEx(
        0,
        CLASS_NAME,
        "Circle Editor - Color Edition",
        WS_OVERLAPPEDWINDOW,

        CW_USEDEFAULT,
        CW_USEDEFAULT,
        800,
        600,

        NULL,
        NULL,
        hInstance,
        NULL
    );

    if(hwnd == NULL)
        return 0;

    // ===== MENU =====

    HMENU hMenu =
        CreateMenu();


    HMENU hCircleMenu =
        CreatePopupMenu();

    AppendMenu(
        hCircleMenu,
        MF_STRING,
        ID_ADD_CIRCLE,
        "Add Circle"
    );

    AppendMenu(
        hCircleMenu,
        MF_STRING,
        ID_REMOVE_CIRCLE,
        "Remove All Circles"
    );

    AppendMenu(
        hMenu,
        MF_POPUP,
        (UINT_PTR)hCircleMenu,
        "Circle"
    );

    SetMenu(hwnd,hMenu);

    ShowWindow(
        hwnd,
        nCmdShow
    );

    SetTimer(
        hwnd,
        1,
        16,
        NULL
    );

    MSG msg = {};

    while(GetMessage(&msg,NULL,0,0))
    {
        TranslateMessage(&msg);

        DispatchMessage(&msg);
    }

    return 0;
}
