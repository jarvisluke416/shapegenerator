#include <windows.h>

// Circle position
int circleX = 350;
int circleY = 100;

// Circle size
double scale = 0.5;

// Resize controls
bool growing = false;
bool shrinking = false;


LRESULT CALLBACK WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
{
    switch (uMsg)
    {

        case WM_PAINT:
        {
            PAINTSTRUCT ps;
            HDC hdc = BeginPaint(hwnd, &ps);

            int x = circleX;
            int y = circleY;
            double s = scale;


            // ===== CIRCLE =====
            Ellipse(
                hdc,
                x,
                y,
                (int)(x + 100 * s),
                (int)(y + 100 * s)
            );


            EndPaint(hwnd, &ps);
            return 0;
        }


        // ===== KEY PRESSED =====
        case WM_KEYDOWN:
        {
            switch (wParam)
            {
                // Movement
                case VK_LEFT:
                    circleX -= 10;
                    break;

                case VK_RIGHT:
                    circleX += 10;
                    break;

                case VK_UP:
                    circleY -= 10;
                    break;

                case VK_DOWN:
                    circleY += 10;
                    break;


                // Grow
                case VK_ADD:        // Numpad +
                case VK_OEM_PLUS:   // Keyboard +
                    growing = true;
                    break;


                // Shrink
                case VK_SUBTRACT:   // Numpad -
                case VK_OEM_MINUS:  // Keyboard -
                    shrinking = true;
                    break;
            }


            InvalidateRect(hwnd, NULL, TRUE);
            return 0;
        }



        // ===== KEY RELEASED =====
        case WM_KEYUP:
        {
            switch (wParam)
            {
                // Stop growing
                case VK_ADD:
                case VK_OEM_PLUS:
                    growing = false;
                    break;


                // Stop shrinking
                case VK_SUBTRACT:
                case VK_OEM_MINUS:
                    shrinking = false;
                    break;
            }

            return 0;
        }



        // ===== TIMER =====
        case WM_TIMER:
        {
            if (growing)
            {
                scale += 0.02;
            }


            if (shrinking)
            {
                scale -= 0.02;
            }


            // Size limits
            if (scale > 3.0)
                scale = 3.0;


            if (scale < 0.1)
                scale = 0.1;


            InvalidateRect(hwnd, NULL, TRUE);

            return 0;
        }



        case WM_DESTROY:
        {
            KillTimer(hwnd, 1);
            PostQuitMessage(0);
            return 0;
        }

    }


    return DefWindowProc(hwnd, uMsg, wParam, lParam);
}




int WINAPI WinMain(
    HINSTANCE hInstance,
    HINSTANCE,
    LPSTR,
    int nCmdShow)
{
    const char CLASS_NAME[] = "CircleWindow";


    WNDCLASS wc = {};

    wc.lpfnWndProc = WindowProc;
    wc.hInstance = hInstance;
    wc.lpszClassName = CLASS_NAME;


    RegisterClass(&wc);



    HWND hwnd = CreateWindowEx(
        0,
        CLASS_NAME,
        "Resizable Moving Circle",
        WS_OVERLAPPEDWINDOW,

        CW_USEDEFAULT,
        CW_USEDEFAULT,
        800,
        600,

        NULL,
        NULL,
        hInstance,
        NULL
    );



    if (hwnd == NULL)
        return 0;



    ShowWindow(hwnd, nCmdShow);


    // Timer runs every 16 milliseconds (~60 FPS)
    SetTimer(hwnd, 1, 16, NULL);



    MSG msg = {};

    while (GetMessage(&msg, NULL, 0, 0))
    {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }



    return 0;
}
