#include <windows.h>

// Stickman position
int stickmanX = 350;
int stickmanY = 100;

// Stickman size
double scale = 0.5;


LRESULT CALLBACK WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
{
    switch (uMsg)
    {

        case WM_PAINT:
        {
            PAINTSTRUCT ps;
            HDC hdc = BeginPaint(hwnd, &ps);


            int x = stickmanX;
            int y = stickmanY;
            double s = scale;


            // ===== HEAD =====
            Ellipse(
                hdc,
                (int)(x + 0*s),
                (int)(y + 0*s),
                (int)(x + 100*s),
                (int)(y + 100*s)
            );


            // ===== EYES =====
            Ellipse(
                hdc,
                (int)(x + 25*s),
                (int)(y + 30*s),
                (int)(x + 40*s),
                (int)(y + 45*s)
            );

            Ellipse(
                hdc,
                (int)(x + 60*s),
                (int)(y + 30*s),
                (int)(x + 75*s),
                (int)(y + 45*s)
            );


            // ===== SMILE =====
            Arc(
                hdc,
                (int)(x + 25*s),
                (int)(y + 40*s),
                (int)(x + 75*s),
                (int)(y + 80*s),
                (int)(x + 25*s),
                (int)(y + 60*s),
                (int)(x + 75*s),
                (int)(y + 60*s)
            );


            // ===== BODY =====
            MoveToEx(
                hdc,
                (int)(x + 50*s),
                (int)(y + 100*s),
                NULL
            );

            LineTo(
                hdc,
                (int)(x + 50*s),
                (int)(y + 250*s)
            );


            // ===== ARMS =====

            MoveToEx(
                hdc,
                (int)(x + 50*s),
                (int)(y + 150*s),
                NULL
            );

            LineTo(
                hdc,
                (int)(x - 50*s),
                (int)(y + 200*s)
            );


            MoveToEx(
                hdc,
                (int)(x + 50*s),
                (int)(y + 150*s),
                NULL
            );

            LineTo(
                hdc,
                (int)(x + 150*s),
                (int)(y + 200*s)
            );


            // ===== LEGS =====

            MoveToEx(
                hdc,
                (int)(x + 50*s),
                (int)(y + 250*s),
                NULL
            );

            LineTo(
                hdc,
                (int)(x - 20*s),
                (int)(y + 350*s)
            );


            MoveToEx(
                hdc,
                (int)(x + 50*s),
                (int)(y + 250*s),
                NULL
            );

            LineTo(
                hdc,
                (int)(x + 120*s),
                (int)(y + 350*s)
            );


            EndPaint(hwnd, &ps);
            return 0;
        }


        // ===== KEYBOARD CONTROLS =====
        case WM_KEYDOWN:
        {
            switch (wParam)
            {
                case VK_LEFT:
                    stickmanX -= 10;
                    break;

                case VK_RIGHT:
                    stickmanX += 10;
                    break;

                case VK_UP:
                    stickmanY -= 10;
                    break;

                case VK_DOWN:
                    stickmanY += 10;
                    break;
            }


            // Tell Windows to redraw the window
            InvalidateRect(hwnd, NULL, TRUE);

            return 0;
        }


        case WM_DESTROY:
        {
            PostQuitMessage(0);
            return 0;
        }
    }


    return DefWindowProc(hwnd, uMsg, wParam, lParam);
}



int WINAPI WinMain(
    HINSTANCE hInstance,
    HINSTANCE,
    LPSTR,
    int nCmdShow)
{
    const char CLASS_NAME[] = "StickmanWindow";


    WNDCLASS wc = {};

    wc.lpfnWndProc = WindowProc;
    wc.hInstance = hInstance;
    wc.lpszClassName = CLASS_NAME;


    RegisterClass(&wc);


    HWND hwnd = CreateWindowEx(
        0,
        CLASS_NAME,
        "My Moving Stickman",
        WS_OVERLAPPEDWINDOW,

        CW_USEDEFAULT,
        CW_USEDEFAULT,
        800,
        600,

        NULL,
        NULL,
        hInstance,
        NULL
    );


    if (hwnd == NULL)
        return 0;


    ShowWindow(hwnd, nCmdShow);


    MSG msg = {};

    while (GetMessage(&msg, NULL, 0, 0))
    {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }


    return 0;
}
